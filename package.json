{
  "name": "allman-braces",
  "displayName": "Allman Braces",
  "description": "Automatically expands inline curly braces to Allman style when pressing Enter.",
  "version": "0.0.1",
   "publisher": "LIRO",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "allman.enter",
        "title": "Allman Enter"
      }
    ],
    "keybindings": [
      {
        "command": "allman.enter",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && !parameterHintsVisible && !inSnippetMode"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
